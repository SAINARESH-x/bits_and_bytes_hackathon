# ---------------------------------------------------------------------------
# DigSync environment variables
#
# Copy to `.env.local` for local dev:   cp .env.example .env.local
# NEVER commit a real .env.local — `.gitignore` excludes every `.env*` file.
#
# Demo mode is the default. With no Supabase values below, the app reads
# data/seed.json and /api/health reports {"mode":"demo"}.
# ---------------------------------------------------------------------------

# Supabase project settings (Project Settings -> API).
# Leave blank to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. RLS must be on; this key bypasses RLS, so it must never be
# exposed to the browser (no NEXT_PUBLIC_ prefix) and never hard-coded.
SUPABASE_SERVICE_ROLE_KEY=

# Gate for any future admin/official action in demo mode.
# In the demo, set DEMO_PASSCODE to the same value in your local .env.local
# and in Vercel's Environment Variables.
DEMO_PASSCODE=
